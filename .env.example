# Supabase connection
NEXT_PUBLIC_APP_URL=https://your-app-url.com
# Cart status threshold: 10–1440 minutes (default 60)
ABANDONED_CART_MINUTES=30
# Protects the Vercel cron request for /api/cron/abandoned-carts.
# Use a long random secret and configure the same value in Vercel.
CRON_SECRET=replace-with-a-long-random-secret

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Resend (email)
# On the free tier you can only send to your own verified email address.
# To send to other recipients, verify a domain at resend.com/domains and
# set RESEND_FROM_EMAIL to an address on that domain.
RESEND_API_KEY=your-resend-api-key-here
RESEND_FROM_EMAIL=AJR <onboarding@resend.dev>
# Cart reminder email is sent only after purpose-specific cart-reminder consent.
NOTIFICATIONS_EMAIL_ENABLED=true
SUPPORT_EMAIL=your-support-email@example.com

# Fast2SMS (order SMS; use the approved DLT template and sender ID)
FAST2SMS_API_KEY=your-fast2sms-api-key
FAST2SMS_MESSAGE_ID_ORDER_PLACED=your-approved-dlt-message-id
FAST2SMS_SENDER_ID=your-approved-sender-id
NOTIFICATIONS_SMS_ENABLED=true

# Meta WhatsApp Cloud API (create and approve a Utility template named below)
# Template body must have these four placeholders in order:
# Hi {{1}}, your AJR order {{2}} has been received. Total: {{3}}. Payment status: {{4}}. Thank you for shopping with AJR.
META_WHATSAPP_ACCESS_TOKEN=your-meta-whatsapp-access-token
META_WHATSAPP_PHONE_NUMBER_ID=your-meta-phone-number-id
META_WHATSAPP_ORDER_TEMPLATE=ajr_order_confirmation
META_WHATSAPP_ABANDONED_CART_TEMPLATE=ajr_abandoned_cart_reminder
META_WHATSAPP_TEMPLATE_LANGUAGE=en_US
META_GRAPH_API_VERSION=v23.0
NOTIFICATIONS_WHATSAPP_ENABLED=true
META_APP_SECRET=your-meta-app-secret-for-webhook-signatures
META_WEBHOOK_VERIFY_TOKEN=choose-a-long-webhook-verify-token
RESEND_WEBHOOK_SECRET=whsec_your-resend-webhook-secret
ADMIN_NOTIFICATION_EMAIL=owner@example.com
PAYMENT_WEBHOOK_SECRET=choose-a-long-provider-internal-secret
